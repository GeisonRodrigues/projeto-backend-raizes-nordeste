{
  "info": {
    "name": "Raizes do Nordeste - Trilha Back-end UNINTER",
    "description": "Colecao oficial de testes cobrindo cenarios positivos e negativos da API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenAdmin", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "T01 - Auth/Login valido (Cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Auth/Login valido (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@raizes.com\",\n  \"senha\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "T04 - Produtos/Consultar estoque unidade 1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/unidades/1/estoque?page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "T02 - Pedidos/Listar sem token (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "T05 - Pedidos/Criar pedido valido TOTEM (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"TOTEM\",\n  \"unidadeId\": 1,\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidade\": 2 }\n  ],\n  \"formaPagamento\": \"MOCK\"\n}"
            }
          }
        },
        {
          "name": "Pedidos/Filtrar pedidos por canalPedido",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pedidos?canalPedido=TOTEM"
          }
        }
      ]
    },
    {
      "name": "Pagamento",
      "item": [
        {
          "name": "T09 - Pagamento/Pagamento mock aprovado (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pagamentos/mock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": 1,\n  \"metodo\": \"MOCK_PIX\",\n  \"simularFalha\": false\n}"
            }
          }
        },
        {
          "name": "T10 - Pagamento/Pagamento mock recusado (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pagamentos/mock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": 2,\n  \"metodo\": \"MOCK_CARTAO\",\n  \"simularFalha\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Erros",
      "item": [
        {
          "name": "T03 - Erros/Cliente sem permissao cozinha (403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pedidos/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EM_PREPARO\"\n}"
            }
          }
        },
        {
          "name": "T06 - Erros/Pedido sem canalPedido valido (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"WHATSAPP\",\n  \"unidadeId\": 1,\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }]\n}"
            }
          }
        },
        {
          "name": "T07 - Erros/Pedido quantidade negativa (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"unidadeId\": 1,\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": -3 }]\n}"
            }
          }
        },
        {
          "name": "T08 - Erros/Pedido sem estoque (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"BALCAO\",\n  \"unidadeId\": 1,\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 500 }]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Auditoria",
      "item": [
        {
          "name": "T11 - Auditoria/Consultar logs de acoes sensiveis",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "url": "{{baseUrl}}/auditoria/logs"
          }
        }
      ]
    }
  ]
}
